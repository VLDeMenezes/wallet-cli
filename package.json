{
  "name": "@-vldm/wallet-cli",
  "version": "0.1.1",
  "description": "CLI de desarrollo para sincronizar contratos OpenAPI y simular webhooks a una wallet",
  "type": "module",
  "bin": {
    "wallet-cli": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external openapi-typescript --external @redocly/openapi-core",
    "dev": "tsup src/index.ts --format esm --watch --external openapi-typescript --external @redocly/openapi-core",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^15.1.0",
    "picocolors": "^1.1.1",
    "openapi-typescript": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "tsup": "^9.0.0",
    "typescript": "^5.0.0"
  }
}
